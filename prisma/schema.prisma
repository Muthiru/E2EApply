generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  PENDING
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  GHOSTED
  WITHDRAWN
}

enum StatusSource {
  MANUAL
  EMAIL
  AI
}

enum ConfidenceLevel {
  CONFIRMED
  LIKELY
  MANUAL_REVIEW
}

enum DocumentType {
  CV
  COVER_LETTER
}

model User {
  id           String        @id @default(cuid())
  clerkId      String        @unique
  email        String?
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  applications Application[]
}

model Profile {
  id             String            @id @default(cuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String?
  title          String?
  summary        String?
  location       String?
  phone          String?
  email          String?
  website        String?
  github         String?
  linkedin       String?
  masterCvName   String?
  masterCvData   Bytes?
  masterCvText   String?
  cvSectionOrder String[]
  skills         Skill[]
  experiences    WorkExperience[]
  educations     Education[]
  projects       Project[]
  certifications Certification[]
  preferences    ProfilePreferences?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  level     String?
  years     Int?
  createdAt DateTime @default(now())

  @@unique([profileId, name])
}

model WorkExperience {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company     String
  title       String
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?
  highlights  String[]
  createdAt   DateTime  @default(now())
}

model Education {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution String
  degree      String?
  field       String?
  startDate   DateTime?
  endDate     DateTime?
  gpa         Decimal?
  createdAt   DateTime  @default(now())
}

model Project {
  id           String    @id @default(cuid())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  url          String?
  technologies String[]
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())
}

model Certification {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  issuer    String?
  date      DateTime?
  url       String?
  createdAt DateTime @default(now())
}

model ProfilePreferences {
  id              String  @id @default(cuid())
  profileId       String  @unique
  profile         Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  preferredRoles  String[]
  locations       String[]
  remoteOnly      Boolean @default(false)
  salaryFloor     Int?
  minMatchPercent Int?
}

model Job {
  id            String        @id @default(cuid())
  sourceUrl     String?
  rawText       String?
  source        String?
  title         String
  company       String?
  location      String?
  description   String?
  requirements  String?
  salaryMin     Int?
  salaryMax     Int?
  matchScore    Int?
  matchDetails  Json?
  matchReasoning String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  applications  Application[]

  @@index([company, title])
}

model Application {
  id                    String            @id @default(cuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId                 String
  job                   Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status                ApplicationStatus @default(PENDING)
  matchScoreAtApplication Int?
  cvTemplate             String?          @default("classic")
  clTemplate             String?          @default("classic")
  notes                 String?
  appliedAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  statusEvents          StatusEvent[]
  documents             Document[]

  @@unique([userId, jobId])
}

model StatusEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  from          ApplicationStatus?
  to            ApplicationStatus
  source        StatusSource      @default(MANUAL)
  confidence    ConfidenceLevel?
  note          String?
  createdAt     DateTime          @default(now())

  @@index([applicationId, createdAt])
}

model Document {
  id              String         @id @default(cuid())
  applicationId   String?
  application     Application?   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type            DocumentType
  version         Int            @default(1)
  content         String?
  storageKey      String?
  fileName        String?
  isFinal         Boolean        @default(false)
  alignmentScore  Int?
  alignmentDetails Json?
  createdAt       DateTime       @default(now())

  @@unique([applicationId, type, version])
}