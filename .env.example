# E2E Apply — environment template (commit this; never commit real values)
# Copy to .env.local and fill in real values.

# PostgreSQL (local: docker compose up -d)
DATABASE_URL="postgresql://e2eapply:e2eapply_dev@localhost:5432/e2eapply"

# Clerk — create app at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# AI provider (Phase 1) — provider-agnostic wrapper, starting with Gemini
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY="AIza-..."

# Web intelligence (Phase 1) — optional; no keys needed for basic use
# Jina Reader + Jina Search: free without a key; add one for higher rate limits
# https://jina.ai/ (Reader = r.jina.ai page crawling, Search = s.jina.ai discovery)
JINA_API_KEY=""

# Exa semantic web search: optional; Jina Search is the no-key fallback
# https://exa.ai/dashboard
EXA_API_KEY=""